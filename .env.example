# Copie este archivo a .env. Todos los valores son de demostración; no use secretos reales.
PORT=3000
DATABASE_URL=postgres://nexo:nexo_demo@localhost:5432/nexoentrega
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo_demo
POSTGRES_DB=nexoentrega
# Contraseña común de las cuentas ficticias que crea el seed (cámbiela y vuelva a ejecutar el seed para regenerarlas)
SEED_PASSWORD=NexoDemo2026!
# Proveedor del asistente: none (resumen determinista), fixture (anexo del examen) u ollama (modelo local)
AI_PROVIDER=none
AI_FIXTURE=AI-VALID
AI_TIMEOUT_MS=5000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# true solo detrás de HTTPS
COOKIE_SECURE=false
